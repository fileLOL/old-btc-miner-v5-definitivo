# Bitcoin CLI path (auto-detected on Windows if not set)
BITCOIN_CLI=C:\Program Files\Bitcoin\daemon\bitcoin-cli.exe

# Payout address for mined blocks (server-side only, never sent to browser)
PAYOUT_ADDRESS=YOUR_BITCOIN_ADDRESS

# Share difficulty (relative multiplier: share target = block target * this value)
# Higher = easier shares, more frequent reports. For CPU mining on mainnet: 268435456
SHARE_DIFFICULTY=268435456

# Server port
PORT=3000

# CORS origin (set to your Vercel frontend URL)
CORS_ORIGIN=*

# Max concurrent miners
MAX_MINERS=100

# Template refresh interval (ms)
TEMPLATE_REFRESH_MS=30000

# Job timeout - stale after this (ms)
JOB_TIMEOUT_MS=120000

# SQLite database path (relative to project root)
# DB_PATH=data/pool.db

# Pool fee percentage (0-100)
POOL_FEE_PERCENT=2

# PPLNS window size (number of shares to consider for reward distribution)
PPLNS_WINDOW_SIZE=10000

# Minimum payout in satoshis
MIN_PAYOUT_SAT=50000

# Block monitor interval (ms)
BLOCK_MONITOR_MS=30000

# Coinbase maturity (number of confirmations before reward can be spent)
COINBASE_MATURITY=100

# Maximum payout in satoshis (1 BTC = 100000000 sat)
MAX_PAYOUT_SAT=100000000

# Payout processing interval (ms) - how often to check for eligible payouts
PAYOUT_INTERVAL_MS=3600000

# Payout monitor interval (ms) - how often to check broadcast transaction confirmations
PAYOUT_MONITOR_INTERVAL_MS=300000

# Payout pending timeout (ms) - recover stale pending payouts after this time
# If a payout stays 'pending' longer than this, it will be recovered on startup
PAYOUT_PENDING_TIMEOUT_MS=3600000

# Payout dry run mode (true = simulate payouts without sending real BTC)
# IMPORTANT: Keep this true until you are ready to send real Bitcoin
PAYOUT_DRY_RUN=true

# Google OAuth2 Client ID for Wallet verification
# Get this from Google Cloud Console > APIs & Services > Credentials
# Must match the Client ID configured in frontend/app.js
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ============================================================
# TEST PAYOUT (isolated real-payout mechanism, separate from production)
# ============================================================
# Enable real-payout test mode (default: false)
# REQUIRES all three TEST_* variables set simultaneously to actually send BTC
ENABLE_REAL_PAYOUT_TEST=false

# Destination address for the isolated test payout (mainnet only)
# Leave empty to prevent any real test payout from running
TEST_PAYOUT_ADDRESS=

# Amount in satoshis for the test payout (default: 50000 = 0.0005 BTC)
TEST_PAYOUT_SAT=50000

# Path to the isolated test DB (never touches data/pool.db)
TEST_PAYOUT_DB_PATH=data/test-payout.db
